# Use the pooled endpoint for serverless application traffic.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/ruralcare?sslmode=require&pgbouncer=true"

# Use the direct endpoint for Prisma schema changes during build/deployment.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/ruralcare?sslmode=require"

# Set to false only when you explicitly want to disable the prototype reset button.
ENABLE_DEMO_RESET="true"
